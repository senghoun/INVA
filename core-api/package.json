{
  "name": "inva-core-system",
  "version": "1.0.0",
  "description": "Core API for the inva multi-domain enterprise ecosystem",
  "author": "inva",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npx nest build api-gateway && npx nest build auth-service && npx nest build hr-service && npx nest build crm-service && npx nest build ac-service && npx nest build it-service",
    "build:gateway": "npx nest build api-gateway",
    "build:auth": "npx nest build auth-service",
    "build:hr": "npx nest build hr-service",
    "build:crm": "npx nest build crm-service",
    "build:ac": "npx nest build ac-service",
    "build:it": "npx nest build it-service",
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,AUTH,HR,CRM,AC,IT\" -c \"cyan,blue,green,yellow,magenta,red\" \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:hr\" \"npm run start:crm\" \"npm run start:ac\" \"npm run start:it\"",
    "start:all": "npm run dev:all",
    "start:gateway": "npx nest start api-gateway --watch",
    "start:auth": "npx nest start auth-service --watch",
    "start:hr": "npx nest start hr-service --watch",
    "start:crm": "npx nest start crm-service --watch",
    "start:ac": "npx nest start ac-service --watch",
    "start:it": "npx nest start it-service --watch",
    "start:prod:gateway": "node dist/apps/api-gateway/apps/api-gateway/src/main.js",
    "start:prod:auth": "node dist/apps/auth-service/apps/auth-service/src/main.js",
    "start:prod:hr": "node dist/apps/hr-service/apps/hr-service/src/main.js",
    "start:prod:crm": "node dist/apps/crm-service/apps/crm-service/src/main.js",
    "start:prod:ac": "node dist/apps/ac-service/apps/ac-service/src/main.js",
    "start:prod:it": "node dist/apps/it-service/apps/it-service/src/main.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "prisma:generate": "npx prisma generate --schema=prisma/auth/schema.prisma && npx prisma generate --schema=prisma/hr/schema.prisma && npx prisma generate --schema=prisma/ac/schema.prisma && npx prisma generate --schema=prisma/crm/schema.prisma && npx prisma generate --schema=prisma/it/schema.prisma",
    "prisma:generate:auth": "npx prisma generate --schema=prisma/auth/schema.prisma",
    "prisma:generate:hr": "npx prisma generate --schema=prisma/hr/schema.prisma",
    "prisma:generate:ac": "npx prisma generate --schema=prisma/ac/schema.prisma",
    "prisma:generate:crm": "npx prisma generate --schema=prisma/crm/schema.prisma",
    "prisma:generate:it": "npx prisma generate --schema=prisma/it/schema.prisma",
    "prisma:migrate:auth": "npx prisma migrate dev --schema=prisma/auth/schema.prisma",
    "prisma:migrate:hr": "npx prisma migrate dev --schema=prisma/hr/schema.prisma",
    "prisma:migrate:ac": "npx prisma migrate dev --schema=prisma/ac/schema.prisma",
    "prisma:migrate:crm": "npx prisma migrate dev --schema=prisma/crm/schema.prisma",
    "prisma:migrate:it": "npx prisma migrate dev --schema=prisma/it/schema.prisma",
    "prisma:migrate:all": "npm run prisma:migrate:auth && npm run prisma:migrate:hr && npm run prisma:migrate:ac && npm run prisma:migrate:crm && npm run prisma:migrate:it",
    "prisma:studio:auth": "npx prisma studio --schema=prisma/auth/schema.prisma",
    "prisma:studio:hr": "npx prisma studio --schema=prisma/hr/schema.prisma",
    "prisma:studio:ac": "npx prisma studio --schema=prisma/ac/schema.prisma",
    "prisma:studio:crm": "npx prisma studio --schema=prisma/crm/schema.prisma",
    "prisma:studio:it": "npx prisma studio --schema=prisma/it/schema.prisma",
    "seed:admin": "npx ts-node -r dotenv/config prisma/seed.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "prisma:deploy:auth": "npx prisma migrate deploy --schema=prisma/auth/schema.prisma",
    "prisma:deploy:hr": "npx prisma migrate deploy --schema=prisma/hr/schema.prisma",
    "prisma:deploy:ac": "npx prisma migrate deploy --schema=prisma/ac/schema.prisma",
    "prisma:deploy:crm": "npx prisma migrate deploy --schema=prisma/crm/schema.prisma",
    "prisma:deploy:it": "npx prisma migrate deploy --schema=prisma/it/schema.prisma",
    "prisma:deploy:all": "npm run prisma:deploy:auth && npm run prisma:deploy:hr && npm run prisma:deploy:ac && npm run prisma:deploy:crm && npm run prisma:deploy:it",
    "infra:start": "node scripts/local-infra.cjs start",
    "infra:status": "node scripts/local-infra.cjs status",
    "postinstall": "npm run prisma:generate",
    "dev:local": "npm run infra:start && npm run prisma:deploy:all && npm run dev:all",
    "migrate:legacy-users": "node scripts/migrate-legacy-users.cjs",
    "test:legacy-users": "node -r ts-node/register --test scripts/migration/legacy-users.test.cjs",
    "test:password-reset": "node -r tsconfig-paths/register --test scripts/password-reset.test.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/http-proxy": "^11.6.3",
    "@fastify/static": "^10.1.5",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "ioredis": "^5.4.1",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "$fastify"
    }
  }
}
