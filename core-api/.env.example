# =============================================================================
# inva-core-system — Environment Configuration
# Copy to .env and fill in values. Never commit the actual .env file.
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE — Component variables (used by Docker Compose)
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
POSTGRES_USER=inva
POSTGRES_PASSWORD=inva

# Individual database names (created by docker/postgres/init.sh)
POSTGRES_AUTH_DB=inva_auth_db
POSTGRES_HR_DB=inva_hr_db
POSTGRES_AC_DB=inva_ac_db
POSTGRES_CRM_DB=inva_crm_db
POSTGRES_IT_DB=inva_it_db
POSTGRES_PV_DB=inva_pv_db

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE — Full DSN URLs (used by Prisma — one per domain)
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_AUTH_URL="postgresql://inva:inva@localhost:5432/inva_auth_db?schema=public"
DATABASE_HR_URL="postgresql://inva:inva@localhost:5432/inva_hr_db?schema=public"
DATABASE_AC_URL="postgresql://inva:inva@localhost:5432/inva_ac_db?schema=public"
DATABASE_CRM_URL="postgresql://inva:inva@localhost:5432/inva_crm_db?schema=public"
DATABASE_IT_URL="postgresql://inva:inva@localhost:5432/inva_it_db?schema=public"
DATABASE_PV_URL="postgresql://inva:inva@localhost:5432/inva_pv_db?schema=public"

# ──────────────────────────────────────────────────────────────────────────────
# REDIS (BullMQ)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────────
# JWT / AUTH
# ──────────────────────────────────────────────────────────────────────────────
# HS256 shared secret — minimum 64 characters in production
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET_FOR_REFRESH
JWT_REFRESH_EXPIRY=7d

# Browser session origins: exact origins, comma-separated; required for production browser login.
# LAN development needs its exact URL here and its hostname in the saved Auth domain allowlist.
BROWSER_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Hex-encoded random 32-byte key stored outside PostgreSQL. MFA remains unavailable until configured.
# Preserve this key across restarts and database restores; do not regenerate for enrolled accounts.
MFA_ENCRYPTION_KEY=
# Public signup is disabled. Admin-created accounts remain available.
PUBLIC_REGISTRATION_ENABLED=false

# Telegram monitoring — disabled until you configure a bot and destination chat.
# Keep bot tokens in deployment secrets, never source control.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_SECONDS=60
# Per service process; six processes share the bot/chat.
TELEGRAM_ALERT_MAX_PER_MINUTE=20
TELEGRAM_SECURITY_FAILURE_THRESHOLD=10
TELEGRAM_SECURITY_WINDOW_SECONDS=60
# Only trust actual reverse proxy IPs/CIDRs so clients cannot forge their address.
GATEWAY_TRUSTED_PROXIES=

# Auth-service only: stable, hex-encoded random 32-byte key for saved bot tokens.
# Back up this key separately from PostgreSQL; preserve it across restarts.
TELEGRAM_ENCRYPTION_KEY=
# Optional metadata for initial environment import; replacements are verified with Telegram.
TELEGRAM_BOT_USERNAME=

# Password recovery: disabled | local | live. Local requires NODE_ENV=development/test.
# Local codes are stored only in .local/password-reset-outbox/<challengeId>.json (0600).
PASSWORD_RESET_DELIVERY=disabled
# Implemented SMS adapter: twilio. Leave blank until the selected provider is configured.
PASSWORD_RESET_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Dedicated recovery bot; do not reuse the shared monitoring bot/chat.
PASSWORD_RESET_TELEGRAM_BOT_TOKEN=
PASSWORD_RESET_TELEGRAM_BOT_USERNAME=
# Random 32+ characters, A-Z/a-z/0-9/_/-. Configure the same secret in Telegram setWebhook.
PASSWORD_RESET_TELEGRAM_WEBHOOK_SECRET=
