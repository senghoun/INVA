# ==============================================================================
# INVA SUPER-APP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust the variables according to your environment.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME="INVA SUPER-APP"
VITE_APP_TAGLINE="API Gateway & Microservices Control Center"
VITE_APP_VERSION="2.0.0"
VITE_APP_ENV="development"
VITE_PORT=5174

# ──────────────────────────────────────────────────────────────────────────────
# API GATEWAY & ROUTING
# ──────────────────────────────────────────────────────────────────────────────
# Centralized API Version (e.g. /api/v1 or /api/v2)
VITE_API_VERSION=/api/v1

# Base URL for API requests.
# - Leave blank ("") when developing locally (requests route through Vite dev server proxy).
# - Set to "http://127.0.0.1:3000" for direct Gateway access or in production.
VITE_API_BASE_URL=

# Fastify API Gateway URL & Port
VITE_GATEWAY_URL=http://127.0.0.1:3000
VITE_GATEWAY_PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# DOWNSTREAM MICROSERVICES (Ports & Direct URLs)
# Corresponds directly to core-api/.env network topology
# ──────────────────────────────────────────────────────────────────────────────
VITE_AUTH_SERVICE_PORT=3001
VITE_AUTH_SERVICE_URL=http://127.0.0.1:3001

VITE_HR_SERVICE_PORT=3002
VITE_HR_SERVICE_URL=http://127.0.0.1:3002

VITE_CRM_SERVICE_PORT=3003
VITE_CRM_SERVICE_URL=http://127.0.0.1:3003

VITE_AC_SERVICE_PORT=3004
VITE_AC_SERVICE_URL=http://127.0.0.1:3004

VITE_IT_SERVICE_PORT=3005
VITE_IT_SERVICE_URL=http://127.0.0.1:3005

# ──────────────────────────────────────────────────────────────────────────────
# HEALTH MONITOR & TELEMETRY
# ──────────────────────────────────────────────────────────────────────────────
# Heartbeat polling interval in milliseconds (default: 3000ms)
VITE_DEFAULT_POLL_INTERVAL=3000

# ──────────────────────────────────────────────────────────────────────────────
# AI ASSISTANTS & COPILOT APIS
# ──────────────────────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=
VITE_ATRIA_API_URL=https://api.atria-asi.ai
VITE_ATRIA_API_KEY=
VITE_ATRIA_MODEL=Atria-Dawn-Preview
